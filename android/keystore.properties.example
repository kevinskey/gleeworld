# Copy this file to `keystore.properties` (which is .gitignored) and
# fill in the values for your release keystore.
#
# Generating a keystore (one time):
#
#   keytool -genkey -v \
#     -keystore $HOME/.android/gleeworld-upload.keystore \
#     -storepass <YOUR_PASSWORD> -keypass <YOUR_PASSWORD> \
#     -alias gleeworld-upload \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=GleeWorld, OU=Engineering, O=GleeWorld, L=Atlanta, ST=GA, C=US"
#
# Then point storeFile here at the file you just made.

storeFile=/Users/you/.android/gleeworld-upload.keystore
storePassword=changeme
keyAlias=gleeworld-upload
keyPassword=changeme
