# @react-pdf-viewer/core@3.12 declares a peer dep on pdfjs-dist ^2 || ^3, but
# this project deliberately runs pdfjs-dist 5 (see the worker/ESM notes in
# CLAUDE.md — pdfjs 5's pdf.worker.mjs is why vite.config.ts sets
# worker.format = 'es'). With npm's default strict peer resolution that
# conflict makes *every* `npm install` fail with ERESOLVE, which is how
# @elevenlabs/client ended up declared in package.json but never installed —
# and that broke `npm run build`.
#
# Downgrading the viewer or pdfjs is the real fix; until then this keeps
# installs working the way they were evidently being run by hand.
legacy-peer-deps=true
