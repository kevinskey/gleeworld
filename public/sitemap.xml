<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!--
    Public, indexable URLs on the GleeWorld marketing/main site.
    Tenant subdomains (kevin.gleeworld.org, demo.gleeworld.org, etc.)
    are excluded on purpose — their content is per-tenant and reached
    via the tenant-bootstrap redirect, not via search.
  -->
  <url>
    <loc>https://gleeworld.org/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Legal + trust surface -->
  <url>
    <loc>https://gleeworld.org/terms-of-service</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://gleeworld.org/privacy-policy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://gleeworld.org/copyright-policy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>https://gleeworld.org/security</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://gleeworld.org/dpa</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <!-- All-State. Only the directory is listed: per-state pages render nothing
       until their programs are flipped to verification_status='verified', so
       listing an unverified state would point crawlers at an empty page. Add
       /all-state/<slug> here as each state is verified. -->
  <url>
    <loc>https://gleeworld.org/all-state</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
